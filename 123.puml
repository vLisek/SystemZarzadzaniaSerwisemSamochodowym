@startuml
scale max 1600 width
left to right direction
skinparam linetype ortho

' ========== DAO ==========
package project.app.dao {
    class BodyTypeDAO
    class BrandDAO
    class CarDAO
    class ClientTypeDAO
    class CustomerDAO
    class DriveTypeDAO
    class EmployeeDAO
    class EngineTypeDAO
    class FuelTypeDAO
    class ModelDAO
    class OrderDAO
    class PartsDAO
    class ServiceDAO
}
' ========== MODEL ==========
package project.app.model {
    class BodyType
    class Brand
    class ClientType
    class Customer
    class DriveType
    class Employee
    class EngineType
    class FuelType
    class Model
    class Order
    class VehicleDisplay
    class Parts
    class Service
}
' ========== UTILS ==========

package project.app.utils {
    class AlertUtils
    class Constants
    class DatabaseConnector
