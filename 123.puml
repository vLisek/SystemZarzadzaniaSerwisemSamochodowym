' Kontrolery
CalendarController --> OrderDAO
CalendarController --> Order

CarPartsController --> PartsDAO
CarPartsController --> Parts
CarPartsController --> AlertUtils

CarsController --> Brand
CarsController --> Model
CarsController --> BodyType
