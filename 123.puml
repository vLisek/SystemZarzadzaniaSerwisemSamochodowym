' DAO relacje
BodyTypeDAO --> BodyType
BodyTypeDAO --> DatabaseConnector

BrandDAO --> Brand
BrandDAO --> DatabaseConnector

CarDAO --> VehicleDisplay
CarDAO --> DatabaseConnector

ClientTypeDAO --> ClientType
ClientTypeDAO --> DatabaseConnector

CustomerDAO --> Customer
CustomerDAO --> DatabaseConnector

DriveTypeDAO --> DriveType
DriveTypeDAO --> DatabaseConnector

EmployeeDAO --> Employee
EmployeeDAO --> DatabaseConnector

EngineTypeDAO --> EngineType
EngineTypeDAO --> DatabaseConnector

FuelTypeDAO --> FuelType
FuelTypeDAO --> DatabaseConnector

ModelDAO --> BrandDAO
ModelDAO --> Model
ModelDAO --> DatabaseConnector
Model --> Brand

OrderDAO --> Order
Order --> Customer
Order --> VehicleDisplay
Order --> Employee
Order --> Service
Order --> Parts

PartsDAO --> Parts
PartsDAO --> DatabaseConnector

ServiceDAO --> Service
