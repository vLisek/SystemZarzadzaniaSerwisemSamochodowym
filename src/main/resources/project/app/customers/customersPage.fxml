                <TextField fx:id="lastNameTextField" layoutX="15.0" layoutY="126.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="32.0" prefWidth="306.0" promptText="Nazwisko" styleClass="textField" />
                <TextField fx:id="phoneTextField" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="32.0" prefWidth="306.0" promptText="Numer telefonu" styleClass="textField" />
                <TextField fx:id="emailTextField" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="32.0" prefWidth="306.0" promptText="Adres e-mail (opcjonalny)" styleClass="textField">
