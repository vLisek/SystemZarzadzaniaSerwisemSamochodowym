            <TextField fx:id="phoneNumberTextField" layoutX="15.0" layoutY="52.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="32.0" prefWidth="306.0" promptText="Numer telefonu" styleClass="textField" />
            <TextField fx:id="positionTextField" layoutX="15.0" layoutY="89.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="32.0" prefWidth="306.0" promptText="Stanowisko" styleClass="textField" />
