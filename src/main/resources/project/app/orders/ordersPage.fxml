                <ComboBox fx:id="partComboBox" layoutX="15.0" layoutY="200.0" prefHeight="32.0" prefWidth="306.0" promptText="Rodzaj części" styleClass="comboBox" />
            <DatePicker fx:id="deadlinePicker" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="44.0" prefWidth="306.0" promptText="Termin oddania" />
